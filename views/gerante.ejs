<!DOCTYPE html>
<html>
        <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <!-- <script src="../jquery-3.7.1.js" type="text/javascript"></script> -->
                <link rel="stylesheet" href="/css/gerante.css">
                <script src="../database/database.js"></script> 
                <title>Le miyagazin</title>
        </head>
        <body>
                <h1>Bienvenue à la gérante</h1>
                <form action="http://localhost:8080/", >
                        <input type="submit" value="back">
                </form>

                <!-- <button id="btnAfficherClients">Afficher les clients</button> -->
                <div id="listeClients">
                
                        <h1>Liste des clients :</h1>
                        <ul>
                        <% clients.forEach(client => { %>
                                <li><%= client.nom %> <%= client.prenom %></li>
                        <% }); %>
                        </ul>
                </div>

                <button onclick="afficherClients()">Afficher Clients</button> 
                <div id="clientsContainer"></div>
        </body>
</html>