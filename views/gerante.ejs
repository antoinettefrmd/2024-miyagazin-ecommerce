<!DOCTYPE html>
<html>
        <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
                <link rel="stylesheet" href="/css/gerante.css">
                <script src="/js/gerante_interface.js"></script> 
                <link rel="shortcut icon" href="/img/logo.png" />
                <title>Le miyagazin</title>

        </head>
        <body>
                <nav>
                    <h1>Bienvenue sur la page de gestion</h1>
                    <div>
                            <img src="/img/logo.png" alt="logo de la boutique" class="img-fluid" widht="50" height="50">
                            <button id="expandClients">Clients</button>
                            <button id="expandGifts">Cadeaux</button>
                            <button id="showAll">Voir tout</button>
                            <form action="http://localhost:8080/">
                                    <input type="submit" value="Retour">
                            </form>
                    </div>
            </nav>

            <div class="container">
                    <div id="clients" class="section">
                            <h3>Ajouter une cliente <button id="ajoutCliente">&#10133;</button></h3>
                            <% clients.forEach(function(client) { %>
                            <div class="client">
                                    <h3><%= client.nom %></h3>
                                    <p><%= client.prenom %> 
                                        <button class="suppCliente bouttonEmoji" data-id="<%= client.id_cliente %>">&#10006;</button>
                                        <button class="modifCliente bouttonEmoji" data-id="<%= client.id_cliente %>">&#128395;</button>
                                </p>

                            </div>
                            <% }); %>
                    </div>

                    <div id="gifts" class="section">
                        <h3>Ajouter un cadeau <button id="ajoutCadeau">&#10133;</button></h3>
                            <% gifts.forEach(function(gift) { %>
                            <div class="gift">
                                    <h3><%= gift.titre %></h3>
                                    <p> <button class="suppCadeau bouttonEmoji" data-id="<%= gift.id_kdo %>">&#10006;</button>
                                        <button class="modifCadeau bouttonEmoji" data-id="<%= gift.id_kdo %>">&#128395;</button></p>
                            </div>
                            <% }); %>
                    </div>
            </div>

            <div id="formContainer" class = section>
                    <form id="myForm" method="post">
                        <div class="form-row" style="display: none;">
                                <label for="id">ID :</label>
                                <input type="text" id="id" name="id" placeholder="Son id">
                            </div>
                        <div class="form-row">
                            <label for="nom">Nom :</label>
                            <input type="text" id="nom" name="nom" placeholder="Son nom">
                        </div>
                        <div class="form-row">
                            <label for="prenom">Prénom :</label>
                            <input type="text" id="prenom" name="prenom" placeholder="Son prénom">
                        </div>
                        <div class="form-row">
                            <label for="email">Email :</label>
                            <input type="email" id="email" name="email" placeholder="Son email">
                        </div>
                        <div class="form-row" id="cacheAnniv">
                            <label for="anniversaire">Date de naissance :</label>
                            <input type="date" id="anniversaire" name="anniversaire">
                        </div>
                        <div class="form-row">
                            <label for="identifiant">Identifiant :</label>
                            <input type="text" id="identifiant" name="identifiant" placeholder="Son identifiant">
                        </div>
                        <div class="form-row">
                            <label for="mdp">Mot de passe :</label>
                            <input type="password" id="mdp" name="mdp" placeholder="Son mot de passe">
                        </div>
                        <div class="form-row">
                                <label for="nbp">Nombre de points :</label>
                                <input type="text" id="nbp" name="nbp" placeholder="Son nombre de points" value="30">
                            </div>
                        <button type="submit">Envoyer</button>
                    </form>
                </div>

        
                <div id="formContainer" class = section>
                        <form id="myFormCadeau" method="post">
                                <div class="form-row" style="display: none;">
                                <label for="cadeau">ID-cadeau :</label>
                                <input type="text" id="idCadeau" name="idCadeau" placeholder="Son id-cadeau">
                                </div>
                            <div class="form-row">
                                <label for="titre">Titre :</label>
                                <input type="text" id="titre" name="titre" placeholder="Son titre">
                            </div>
                            <div class="form-row">
                                <label for="prix">Prix :</label>
                                <input type="text" id="prix" name="prix" placeholder="Son prix">
                            </div>
                            <div class="form-row">
                                <label for="stock">Stock :</label>
                                <input type="text" id="stock" name="stock" placeholder="Son stock">
                            </div>
                            <div class="form-row">
                                <label for="photo">photo :</label>
                                <input type="text" id="photo" name="photo" placeholder="Sa photo">
                            </div>
                            <button type="submit">Envoyer</button>
                        </form>
                    </div>

    </body>
</html>
