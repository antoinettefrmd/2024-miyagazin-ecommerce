<!DOCTYPE html>
<html>
        <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
                <link rel="stylesheet" href="/css/gerante.css">
                <script src="/js/gerante_interface.js"></script> 
                <title>Le miyagazin</title>

        </head>
        <body>
                <nav>
                        <h1>Bienvenue sur la page de gestion</h1>
                        <div>
                                <img src="/img/logo.png" alt="logo de la boutique" class="img-fluid" widht="50" height="50">
                                <button id="expandClients">Clients</button>
                                <button id="expandGifts">Cadeaux</button>
                                <form action="http://localhost:8080/">
                                        <input type="submit" value="Déconnexion">
                                </form>
                        </div>
                </nav>

                <div class="container">
                        
                        <div id="clients" class="section">
                                <div><h3>Ajouter une cliente <button id='ajoutCliente'>&#10133;</button></h3></div>
                                <% clients.forEach(function(client) { %>
                                <div class="client" >
                                        <h3><%= client.nom %></h3>
                                        <p> <%= client.prenom %> 
                                        <button class="modifCliente bouttonEmoji">&#128395;</button> 
                                        <button class=" suppCliente bouttonEmoji" data-id="<%= client.id_cliente %>">&#10006;</button></p>
                                </div>
                                <% }); %>
                        </div>
                        <div id="gifts" class="section">
                                <% gifts.forEach(function(gift) { %>
                                <div class="gift">
                                        <h3><%= gift.titre %></h3>
                                </div>
                                <% }); %>
                        </div>

                        <div id="formContainer" class='section'>
                        <form id="myForm" action="/gerante/ajoutCliente" method="post">
                            <div class="form-row">
                                <label for="nom">Nom :</label>
                                <input type="text" id="nom" name="nom" placeholder="Votre nom">
                            </div>
                            <div class="form-row">
                                <label for="prenom">Prénom :</label>
                                <input type="text" id="prenom" name="prenom" placeholder="Votre prénom">
                            </div>
                            <div class="form-row">
                                <label for="email">Email :</label>
                                <input type="email" id="email" name="email" placeholder="Votre email">
                            </div>
                            <div class="form-row">
                                <label for="anniversaire">Date de naissance :</label>
                                <input type="date" id="anniversaire" name="anniversaire">
                            </div>
                            <div class="form-row">
                                <label for="identifiant">Identifiant :</label>
                                <input type="text" id="identifiant" name="identifiant" placeholder="Votre identifiant">
                            </div>
                            <div class="form-row">
                                <label for="mdp">Mot de passe :</label>
                                <input type="password" id="mdp" name="mdp" placeholder="Votre mot de passe">
                            </div>
                            <button type="submit">Envoyer</button>
                        </form>
                    </div>
                </div>
  
                

        </body>
</html>